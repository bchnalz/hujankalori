{
  "name": "calorie-catcher",
  "version": "0.1.0",
  "private": true,
  "description": "Calorie Catcher minigame for LAPER — a mobile-first survival catcher (Phaser 3 + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "assets": "node scripts/gen-placeholders.mjs",
    "assets:force": "node scripts/gen-placeholders.mjs --force",
    "predev": "node scripts/gen-placeholders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-placeholders.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "^3.80.1"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
