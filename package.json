{
  "name": "hujan-kalori",
  "version": "0.1.0",
  "private": true,
  "description": "Hujan Kalori minigame for LAPER — a mobile-first survival catcher (Phaser 3 + TypeScript + Vite).",
  "type": "module",
  "scripts": {
    "assets": "node scripts/gen-placeholders.mjs",
    "assets:force": "node scripts/gen-placeholders.mjs --force",
    "predev": "node scripts/gen-placeholders.mjs",
    "dev": "vite",
    "prebuild": "node scripts/gen-placeholders.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "phaser": "^3.80.1",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
